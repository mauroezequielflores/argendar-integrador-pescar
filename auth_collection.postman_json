{
	"info": {
		"_postman_id": "c1a2e3b4-5f6a-7b8c-9d0e-1f2a3b4c5d6e",
		"name": "Argendar Auth API (Corregido)",
		"description": "Colección de Postman optimizada. Genera correos dinámicos para evitar el rate limit de registro y comparte el JWT entre peticiones automáticamente.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Registrar Usuario",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Genera un número aleatorio para evitar el 'email rate limit exceeded'",
							"const randomId = Math.floor(Math.random() * 100000);",
							"pm.collectionVariables.set('dynamic_email', `juan.perez.${randomId}@gmail.com`);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"nombre\": \"Juan\",\n    \"apellido\": \"Pérez\",\n    \"email\": \"{{dynamic_email}}\",\n    \"password\": \"Password123!\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/auth/register",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"register"
					]
				},
				"description": "Crea una cuenta de usuario en el sistema de autenticación de Supabase y sincroniza el perfil público."
			},
			"response": []
		},
		{
			"name": "Iniciar Sesión",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Captura el token real devuelto por el backend y lo asigna a la variable",
							"try {",
							"    const response = pm.response.json();",
							"    if (response.accessToken) {",
							"        pm.collectionVariables.set('jwt_token', response.accessToken);",
							"    } else if (response.data && response.data.session && response.data.session.accessToken) {",
							"        pm.collectionVariables.set('jwt_token', response.data.session.accessToken);",
							"    } else if (response.data && response.data.session && response.data.session.access_token) {",
							"        pm.collectionVariables.set('jwt_token', response.data.session.access_token);",
							"    }",
							"} catch(e) {",
							"    console.log('No se pudo mapear el token de respuesta');",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{dynamic_email}}\",\n    \"password\": \"Password123!\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/auth/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login"
					]
				},
				"description": "Verifica las credenciales del usuario dinámico creado en el paso anterior."
			},
			"response": []
		},
		{
			"name": "Obtener Usuario Actual (Me)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/auth/me",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"me"
					]
				},
				"description": "Obtiene la información de perfil utilizando el token dinámico capturado tras el login."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "argendar-token-valido",
			"type": "string"
		},
		{
			"key": "dynamic_email",
			"value": "",
			"type": "string"
		}
	]
}