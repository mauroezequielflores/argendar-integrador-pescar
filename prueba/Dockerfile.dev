FROM node:22-alpine

WORKDIR /app

# Aprovechar la caché de capas de Docker para las dependencias
COPY package*.json ./
RUN npm install

# Copiar el código fuente del frontend
COPY . .

# Vite corre por defecto en el puerto 5173
EXPOSE 5173

# CRUCIAL: El flag --host expone el servidor fuera del aislamiento del contenedor
CMD ["npm", "run", "dev", "--", "--host"]
