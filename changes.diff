+import { ROUTES } from "../../../constants/routes";
+
+const NAV_ITEMS = [
+  { label: "Servicios",      anchor: "servicios" },
+  { label: "Cómo funciona", anchor: "como-funciona" },
+  { label: "Beneficios",    anchor: "beneficios" },
+  { label: "FAQ",           anchor: "faq" },
+];
